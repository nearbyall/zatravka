# ИИ. Нужен хотя бы один провайдер. DeepSeek — основной, Replicate — запасной.
DEEPSEEK_API_KEY=
REPLICATE_API_TOKEN=

# Reddit OAuth (необязательно; без него используется публичный RSS reddit.com)
# Приложение типа "script": https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=

# X API v2: Bearer token приложения (developer.x.com). Поиск платный.
X_BEARER_TOKEN=

# Threads API: long-lived user token с правами threads_basic, threads_keyword_search
THREADS_ACCESS_TOKEN=

# Telegram-дайджест (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Docker: от какого пользователя писать в ./data (id -u / id -g)
IDEAMINER_UID=1000
IDEAMINER_GID=1000
