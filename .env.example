# LLM: at least one provider. DeepSeek is the main one, Replicate the fallback.
DEEPSEEK_API_KEY=
REPLICATE_API_TOKEN=

# Reddit OAuth, optional; without it the public reddit.com RSS is used.
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=

# X API v2: the app's Bearer token (developer.x.com). Search is paid.
X_BEARER_TOKEN=

# Threads API: a long-lived user token with threads_basic and threads_keyword_search.
THREADS_ACCESS_TOKEN=

# Telegram digest, optional.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Docker: the user that owns files in ./data (id -u / id -g).
ZATRAVKA_UID=1000
ZATRAVKA_GID=1000
